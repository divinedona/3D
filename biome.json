{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "files": {
    "includes": [
      "morrow-site/**/*.{js,jsx,mjs,css}",
      "scripts/**/*.mjs",
      "scripts/**/*.cjs",
      "pages/**/*.css",
      "package.json",
      "vercel.json",
      "biome.json",
      "!!**/dist",
      "!!**/node_modules"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "assist": { "enabled": false }
}
