{
  "name": "morrow-stories",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config morrow-site/vite.config.mjs",
    "dev:pixel": "vite --config morrow-site/pixel-story/vite.config.mjs",
    "dev:fashion": "vite --config morrow-site/fashion-demo/vite.config.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --outDir dist --host 127.0.0.1 --port 5183",
    "check": "biome check . --diagnostic-level=error",
    "verify:build": "node scripts/verify-build.mjs",
    "render:3d": "python morrow-site/video/render_voxel_story.py",
    "render:2d": "python morrow-site/pixel-story/render_pixel_story.py",
    "check:fashion": "node scripts/render-fashion-film.cjs --check",
    "render:fashion": "node scripts/render-fashion-film.cjs"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.3.8"
  }
}
